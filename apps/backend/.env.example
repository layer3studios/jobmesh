# FILE: .env.example — backend environment template. Copy to .env and fill real
# values for local dev. Never commit .env (it is gitignored); this file is
# committed with placeholders only.
#
# Every key below is read by src/env.js (or, where noted, directly by a module).
# Keys marked REQUIRED abort boot when unset. Everything else has a safe default
# and may be omitted entirely.

# ─── Core ─────────────────────────────────────────────────────────
NODE_ENV=development
# Express listen port. Defaults 3000 (Next dev runs on 3001).
PORT=3000
# Canonical frontend origin — used for CORS and for every link in outbound email.
# Defaults http://localhost:5173, which is stale for the Next app; set it.
FRONTEND_URL=https://jobmesh.in

# REQUIRED. MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/jobmesh

# ─── Seeker auth ──────────────────────────────────────────────────
# REQUIRED. Google OAuth client id — must match NEXT_PUBLIC_GOOGLE_CLIENT_ID
# in the frontend env, or Google sign-in fails on token audience.
GOOGLE_CLIENT_ID=
# REQUIRED. Signing secret for the seeker JWT (tj_token cookie).
JWT_SECRET=replace_with_a_long_random_string

# ─── Employer auth ────────────────────────────────────────────────
# REQUIRED. Deliberately separate from JWT_SECRET — the employer identity stack
# is independent, so leaking one audience's secret never grants the other.
EMPLOYER_JWT_SECRET=replace_with_a_long_random_string

# ─── Signed file URLs ─────────────────────────────────────────────
# HMAC secrets for short-lived download tokens. Both fall back to
# EMPLOYER_JWT_SECRET and then a dev literal — a local convenience only.
# Production MUST set both explicitly, and they must differ from each other so
# rotating or leaking one never affects the other.
RESUME_URL_SECRET=replace_with_a_long_random_string
ASSIGNMENT_URL_SECRET=replace_with_a_different_long_random_string

# ─── Admin identity ───────────────────────────────────────────────
# Admin identity is MongoDB-backed (admin_users) + jm_admin_token cookie. The old
# env-based ADMIN_EMAILS is removed — do not reintroduce it.
#
# Bootstrap admin identities. Comma-separated. Read once by
# src/scripts/seed-initial-admins.js. Delete from prod .env after running.
INITIAL_ADMIN_EMAILS=
# Admin session TTL, hours. Defaults 8.
ADMIN_JWT_TTL_HOURS=8

# ─── Scraper ──────────────────────────────────────────────────────
# Run one scrape at boot. Only the literal 'true' enables it.
RUN_SCRAPER_ON_START=false
# Master switch for the scheduled scrape. Only the literal 'false' disables it.
SYNC_ENABLED=true
# Optional — proxy base for the Recruitee/Workable fetchers
# (read directly by src/CompanyConfig/recruiteeConfig.js). Empty = direct.
WORKABLE_PROXY_URL=

# ─── DPDP compliance ──────────────────────────────────────────────
# noticeVersion pins each consent to the notice text the user agreed to.
# All four are REQUIRED when NODE_ENV=production; in dev they default.
DPDP_NOTICE_VERSION=v1.0-2026-07
DPDP_POLICY_URL=/legal/privacy
DPDP_GRIEVANCE_OFFICER_EMAIL=privacy@jobmesh.in
# Reflects our use of Google AI Studio (cross-border processing).
DPDP_CROSS_BORDER_ENABLED=true

# ─── Gemma / Gemini AI ────────────────────────────────────────────
# Comma-separated API keys, ideally from DIFFERENT GCP projects (separate quota
# buckets). All optional — with no keys configured, AI extraction is simply
# disabled and the server boots normally.
GEMMA_API_KEYS=
# Scraper's own key pool (batch work). Falls back to GEMMA_API_KEYS when empty.
GEMMA_SCRAPER_API_KEYS=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── AI per-operation switches ────────────────────────────────────
# Each operation toggles independently without touching keys. Only the scraper
# defaults OFF; the rest stay ON unless set to the literal 'false'.
SCRAPER_JD_EXTRACTION_ENABLED=false
EMPLOYER_JD_EXTRACTION_ENABLED=true
EMPLOYER_SCORING_ENABLED=true
SEEKER_AI_ENABLED=true

# ─── AI model cascades (comma-separated, first = preferred) ───────
# Optional. Omit to use the built-in cascades in src/env.js; set to reorder or
# add models with no code change.
EMPLOYER_AI_MODELS=
SEEKER_AI_MODELS=
SCRAPER_AI_MODELS=
# Stop at this fraction of a model's published rate limit. Defaults 0.85.
AI_SAFETY_MARGIN=0.85

# ─── Admin analytics (PostHog Query API) ──────────────────────────
# Server-only. The personal key (phx_ prefix) is NEVER exposed to the client and
# must never be committed. When POSTHOG_PERSONAL_API_KEY is empty the
# /api/admin/analytics endpoints return 503 and the rest of the app runs
# normally.
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here
# Optional — cache TTL for analytics query results, in milliseconds (default 300000).
ANALYTICS_CACHE_TTL_MS=300000

# ─── Transactional email (Resend) ─────────────────────────────────
# All optional. When RESEND_API_KEY is empty, outbound email is disabled and
# sendTransactionalEmail() returns { sent: false } — the server boots normally.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=Interview@jobmesh.in
EMAIL_FROM_NAME=JobMesh
# Optional — leave empty to omit the Reply-To header entirely.
EMAIL_REPLY_TO_ADDRESS=
# Master switch. Anything other than the literal 'false' keeps email on.
EMAIL_ENABLED=true
# 24h interview reminder sweep. Only the literal 'false' disables it.
INTERVIEW_REMINDERS_ENABLED=true

# ─── Subdomain routing (NAMING-CONVENTIONS §17) ───────────────────
# Cookie scope. The leading dot makes one session valid across every *.jobmesh.in
# host, so a seeker stays signed in walking from jobmesh.in to apply.jobmesh.in.
# LEAVE UNSET IN LOCAL DEV — a domain attribute on localhost is rejected by some
# browsers and silently breaks login.
COOKIE_DOMAIN=.jobmesh.in
# Public origin of the apply/careers host. Used to build shareable referral URLs.
# Defaults to ${FRONTEND_URL}/apply when unset (single-host deploys).
APPLY_URL=https://apply.jobmesh.in
# Extra browser origins allowed to call the API with credentials, comma-separated.
# Every *.jobmesh.in host is already allowed by pattern in server.js; this is for
# one-off origins (a staging host, a preview deploy) without a code change.
CORS_ALLOWED_ORIGINS=https://jobmesh.in,https://hire.jobmesh.in,https://admin.jobmesh.in,https://apply.jobmesh.in
# GitHub GraphQL API token, used only to lift the rate limit on PUBLIC data.
# A fine-grained PAT with NO permissions selected is sufficient and safest.
# Leave unset to disable the GitHub panels; nothing else is affected.
GITHUB_API_TOKEN=your_github_personal_access_token
