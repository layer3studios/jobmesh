/node_modules
package-lock.json
.env

deploy.ps1
# Uploaded resume files (local-disk MVP storage)
data/resumes/
# Short-lived temp PDFs for the async parse queue
data/tmp/
# A seeker's own retained resume PDF, served by their public profile page.
# Same rule as data/resumes/: real candidate documents, never in the repo.
data/seeker-resumes/

ktopjobsync-hubbackend
*jobsync-hub*backend

# Candidate take-home uploads — staged (pre-submit) and committed submissions.
# Same rule as resumes: real candidate files, never in the repo. These directories
# were created by the assignment feature and were NOT covered until now.
data/assignment-staging/
data/assignment-submissions/

# Careers-page culture photos (employer uploads, never in the repo)
data/culture-photos/

# Uploaded profile photos — employer users and seekers both write here through
# avatar-storage-service. Real people's faces: same rule as resumes, never in
# the repo.
data/avatars/
# Company logos, uploaded the same way.
data/logos/
