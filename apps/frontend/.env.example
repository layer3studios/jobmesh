# ── frontend-next environment ─────────────────────────────────────────────
# Client-exposed vars MUST be prefixed NEXT_PUBLIC_ (D6). Everything else is
# server-only. Copy to .env.local and fill real values for local dev.

# Backend API base. Same-origin in prod via nginx → defaults to "/api" (C10).
# Do NOT hardcode https://jobmesh.in/api or http://localhost:4000 anywhere in src.
NEXT_PUBLIC_API_BASE_URL=/api

# Canonical site origin, used for absolute URLs in sitemap/robots/metadata.
# Local dev: http://localhost:3001 (Next runs on 3001, Express backend on 3000).
NEXT_PUBLIC_SITE_URL=https://jobmesh.in

# Google OAuth client id (seeker login). Was VITE_GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# logo.dev token for company logos. Was VITE_LOGODEV_TOKEN.
NEXT_PUBLIC_LOGODEV_TOKEN=

# Server-only: where Next dev rewrites /api/* to (the Express dev port). Not
# exposed to the browser. In prod this is unused (nginx serves same-origin).
DEV_API_PROXY_ORIGIN=http://localhost:3000

# Server-only: origin the server-fetch helper calls the backend on during SSR.
# Server code has no implicit same-origin, so it needs a concrete host. In prod
# point this at the internal backend (e.g. http://127.0.0.1:3000). Falls back to
# DEV_API_PROXY_ORIGIN, then http://localhost:3000, when unset.
SERVER_API_ORIGIN=http://localhost:3000

# PostHog (EU cloud) — product analytics, session replay, web analytics. Client-
# exposed → inlined at BUILD time (a value change requires a rebuild + restart, R8).
# Consent-gated: PostHog never initialises until the visitor accepts analytics
# cookies (jm_analytics_consent). Get the project key from the PostHog dashboard.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Tag Manager — carries GA4. Set the CONTAINER id (GTM-…), not a GA4
# measurement id: the measurement id is configured inside the container, so this
# app never needs it. Consent-gated like everything else here, with Google
# Consent Mode v2 defaults pushed before the container loads (analytics granted,
# every ad_* signal denied — JobMesh runs no advertising).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Microsoft Clarity — heatmaps + session replay. The project id is the short
# token from the Clarity dashboard URL. Consent is passed with Clarity's
# Consent API v2; without it Clarity degrades to a cookieless mode.
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Hosts where analytics may run AT ALL (lib/internal-traffic.ts). Anything else
# — localhost, a LAN IP, a preview deploy — loads no tracker whatsoever, so a
# dev machine cannot pollute production analytics by construction. Comma
# separated, no scheme. A device can also exclude itself with ?jm_internal=1.
NEXT_PUBLIC_ANALYTICS_HOSTS=jobmesh.in,www.jobmesh.in,apply.jobmesh.in

# ─── Subdomain routing (NAMING-CONVENTIONS §17) ───────────────────────────────
# In production each audience is its own host; in dev they are paths on :3001.
# The subdomain-urls.ts helpers read these, so cross-audience links resolve
# correctly in BOTH environments with no code change.
NEXT_PUBLIC_EMPLOYER_URL=https://hire.jobmesh.in
NEXT_PUBLIC_ADMIN_URL=https://admin.jobmesh.in
NEXT_PUBLIC_APPLY_URL=https://apply.jobmesh.in

# Backend API ORIGIN for browser calls. Nginx routes only api.jobmesh.in to
# Express, so a relative '/api' would hit Next and 404. Server-side reads use
# SERVER_API_ORIGIN instead (internal, never through public DNS).
NEXT_PUBLIC_API_URL=https://api.jobmesh.in

# IndexNow (Bing / ChatGPT search). Same value on frontend and backend; 8-128 letters,
# digits or dashes, e.g. `openssl rand -hex 16`. Unset = no submissions.
INDEXNOW_KEY=
